<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Happy Birthday Kakk Sary ❤️</title>

<style>

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    overflow: hidden;

    display: flex;
    justify-content: center;
    align-items: center;

    font-family: Arial, sans-serif;

    background:
        radial-gradient(circle at top, #fff0f6, transparent 45%),
        linear-gradient(135deg, #ffc1d9, #d9d2ff);
}


/* =========================
   LOVE BACKGROUND
========================= */

.love {
    position: fixed;
    bottom: -60px;

    pointer-events: none;
    z-index: 1;

    opacity: 0;

    animation: loveFloat linear forwards;
}

@keyframes loveFloat {

    0% {
        transform:
            translateY(0)
            scale(.5)
            rotate(-10deg);

        opacity: 0;
    }

    15% {
        opacity: .8;
    }

    50% {
        transform:
            translateY(-50vh)
            scale(1)
            rotate(10deg);
    }

    100% {
        transform:
            translateY(-115vh)
            scale(1.3)
            rotate(-10deg);

        opacity: 0;
    }
}


/* =========================
   SCENE
========================= */

.scene {
    position: relative;

    width: 330px;
    height: 500px;

    display: flex;
    justify-content: center;
    align-items: center;

    z-index: 5;
}


/* =========================
   AMPLOP
========================= */

.envelope {
    position: absolute;

    width: 300px;
    height: 200px;

    background: #ff91b6;

    border-radius: 12px;

    cursor: pointer;

    box-shadow:
        0 20px 40px rgba(0,0,0,.2);

    transition: 1s;

    z-index: 10;
}


/* Tutup amplop */

.envelope::before {

    content: "";

    position: absolute;

    top: 0;
    left: 0;

    width: 0;
    height: 0;

    border-left: 150px solid transparent;
    border-right: 150px solid transparent;
    border-top: 110px solid #ff6f9e;

    transform-origin: top;

    transition: 1s;

    z-index: 6;
}


/* Bagian depan amplop */

.envelope::after {

    content: "";

    position: absolute;

    left: 0;
    bottom: 0;

    width: 0;
    height: 0;

    border-left: 150px solid transparent;
    border-right: 150px solid transparent;
    border-bottom: 110px solid #ffb2cc;

    z-index: 3;
}


/* Amplop terbuka */

.envelope.open::before {

    transform:
        rotateX(180deg);

    z-index: 1;
}


/* Love pada amplop */

.envelope-heart {

    position: absolute;

    top: 50%;
    left: 50%;

    transform:
        translate(-50%, -50%);

    font-size: 48px;

    z-index: 8;

    transition: .5s;
}

.envelope.open .envelope-heart {

    opacity: 0;
}


/* =========================
   KARTU
========================= */

.card {

    position: absolute;

    width: 285px;

    min-height: 400px;

    padding: 25px 20px;

    background: rgba(255,255,255,.97);

    border-radius: 22px;

    text-align: center;

    box-shadow:
        0 20px 50px rgba(0,0,0,.2);

    transform:
        translateY(80px)
        scale(.5);

    opacity: 0;

    transition:
        transform 1.3s cubic-bezier(.2,.8,.2,1),
        opacity 1s;

    z-index: 4;
}


/* Kartu muncul */

.card.show {

    transform:
        translateY(-25px)
        scale(1);

    opacity: 1;

    z-index: 15;
}


/* =========================
   ISI KARTU
========================= */

.cake {

    font-size: 58px;

    animation:
        cakeBounce 1.5s infinite;
}

@keyframes cakeBounce {

    0%,100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-8px);
    }
}


h1 {

    margin: 5px 0;

    font-size: 27px;

    color: #ff4f87;
}


h2 {

    margin: 4px 0 14px;

    color: #555;

    font-size: 21px;
}


.message {

    color: #666;

    font-size: 13px;

    line-height: 1.55;
}


/* =========================
   TOMBOL
========================= */

button {

    margin-top: 14px;

    padding:
        10px
        21px;

    border: none;

    border-radius: 30px;

    background:
        linear-gradient(
            135deg,
            #ff5c8a,
            #ff82a8
        );

    color: white;

    font-size: 14px;

    font-weight: bold;

    cursor: pointer;

    box-shadow:
        0 7px 20px rgba(255,92,138,.4);

    transition: .3s;
}

button:hover {

    transform:
        scale(1.08);
}


/* =========================
   TOMBOL HADIAH
========================= */

.gift-button {

    display: none;

    background:
        linear-gradient(
            135deg,
            #b06cff,
            #ff6fae
        );
}

.gift-button.show {

    display: inline-block;

    animation:
        buttonAppear .7s ease;
}

@keyframes buttonAppear {

    from {
        opacity: 0;
        transform: scale(.5);
    }

    to {
        opacity: 1;
        transform: scale(1);
    }
}


/* =========================
   PESAN HADIAH
========================= */

.gift-message {

    display: none;

    margin-top: 12px;

    padding: 12px;

    border-radius: 15px;

    background:
        #fff0f6;

    color: #ff4f87;

    font-size: 13px;

    font-weight: bold;

    line-height: 1.5;

    animation:
        messageAppear .7s ease;
}

.gift-message.show {

    display: block;
}

@keyframes messageAppear {

    from {
        opacity: 0;
        transform:
            translateY(15px)
            scale(.9);
    }

    to {
        opacity: 1;
        transform:
            translateY(0)
            scale(1);
    }
}


/* =========================
   CONFETTI
========================= */

.confetti {

    position: fixed;

    top: -30px;

    width: 9px;
    height: 14px;

    pointer-events: none;

    z-index: 30;

    animation:
        confettiFall linear forwards;
}

@keyframes confettiFall {

    0% {
        transform:
            translateY(0)
            rotate(0deg);

        opacity: 1;
    }

    100% {
        transform:
            translateY(110vh)
            rotate(720deg);

        opacity: 0;
    }
}


/* =========================
   BUNGA
========================= */

.flower {

    position: fixed;

    font-size: 30px;

    pointer-events: none;

    z-index: 20;

    opacity: 0;

    animation:
        flowerPop 2.5s ease forwards;
}

@keyframes flowerPop {

    0% {
        transform:
            scale(.2)
            translateY(50px);

        opacity: 0;
    }

    25% {
        opacity: 1;
    }

    100% {
        transform:
            scale(1.3)
            translateY(-120px);

        opacity: 0;
    }
}


/* =========================
   INFO MUSIK
========================= */

.music-info {

    position: fixed;

    bottom: 15px;
    left: 50%;

    transform:
        translateX(-50%);

    padding:
        8px 15px;

    background:
        rgba(255,255,255,.75);

    border-radius: 20px;

    color: #ff4f87;

    font-size: 12px;

    z-index: 50;
}


/* =========================
   HP KECIL
========================= */

@media (max-width: 380px) {

    .scene {
        transform: scale(.9);
    }

}

</style>
</head>


<body>


<div class="scene">


    <!-- =====================
         AMPLOP
    ====================== -->

    <div
        class="envelope"
        id="envelope"
        onclick="openCard()"
    >

        <div class="envelope-heart">
            💌
        </div>

    </div>


    <!-- =====================
         KARTU
    ====================== -->

    <div
        class="card"
        id="card"
    >

        <div class="cake">
            🎂
        </div>


        <h1>
            Happy Birthday! 🎉
        </h1>


        <h2>
            Kakk Sary ❤️
        </h2>


        <div class="message">

            Selamat ulang tahun, Kakk Sary! 🥳

            <br><br>

            Semoga di usia yang baru ini,
            Kakk Sary selalu diberikan kesehatan,
            kebahagiaan, dan banyak hal baik. ✨

            <br><br>

            Semoga Tuhan Yesus selalu menyertai
            setiap langkah Kakk Sary,
            dan memberkati setiap doa
            serta harapan Kakk Sary. 🙏🏻❤️

            <br><br>

            Tetap jadi Kakk Sary yang baik,
            ceria, dan selalu punya alasan
            untuk tersenyum. 🌷

            <br><br>

            <b>
                Tuhan Yesus memberkati
                Kakk Sary selalu. ❤️
            </b>

            <br><br>

            <b>
                Nathan &lt;3 Sary
            </b>

        </div>


        <!-- Tombol hadiah -->

        <button
            class="gift-button"
            id="giftButton"
            onclick="openGift()"
        >
            🎁 Buka Hadiah
        </button>


        <!-- Pesan hadiah -->

        <div
            class="gift-message"
            id="giftMessage"
        >

            🎁✨<br>

            Hadiah menyusul di hari Senin ❤️

        </div>

    </div>

</div>


<div
    class="music-info"
    id="musicInfo"
>
    🎵 Klik amplop untuk membuka
</div>


<script>


/* =========================
   LOVE BACKGROUND
========================= */

function createLove() {

    const love =
        document.createElement("div");

    love.className = "love";


    const hearts = [
        "❤️",
        "💕",
        "💗",
        "💖",
        "💘",
        "💞"
    ];


    love.innerHTML =
        hearts[
            Math.floor(
                Math.random() *
                hearts.length
            )
        ];


    love.style.left =
        Math.random() * 100 + "vw";


    love.style.fontSize =
        (15 + Math.random() * 30)
        + "px";


    love.style.animationDuration =
        (5 + Math.random() * 5)
        + "s";


    document.body.appendChild(love);


    setTimeout(() => {
        love.remove();
    }, 10000);
}


/* Love terus bermunculan */

setInterval(
    createLove,
    450
);


/* =========================
   MUSIK
========================= */

let audioContext = null;

let musicStarted = false;


const notes = {

    C4: 261.63,
    D4: 293.66,
    E4: 329.63,
    F4: 349.23,
    G4: 392.00,
    A4: 440.00,
    B4: 493.88,
    C5: 523.25

};


function playNote(
    note,
    duration,
    delay
) {

    setTimeout(() => {

        if (!audioContext) {

            audioContext =
                new (
                    window.AudioContext ||
                    window.webkitAudioContext
                )();

        }


        const oscillator =
            audioContext.createOscillator();


        const gain =
            audioContext.createGain();


        oscillator.type =
            "sine";


        oscillator.frequency.value =
            notes[note];


        gain.gain.setValueAtTime(
            .08,
            audioContext.currentTime
        );


        gain.gain.exponentialRampToValueAtTime(
            .001,
            audioContext.currentTime +
            duration
        );


        oscillator.connect(gain);

        gain.connect(
            audioContext.destination
        );


        oscillator.start();


        oscillator.stop(
            audioContext.currentTime +
            duration
        );


    }, delay);

}


function playMusic() {

    if (musicStarted)
        return;


    musicStarted = true;


    const melody = [

        ["C4", .35],
        ["C4", .35],
        ["D4", .7],
        ["C4", .7],
        ["F4", .7],
        ["E4", 1],

        ["C4", .35],
        ["C4", .35],
        ["D4", .7],
        ["C4", .7],
        ["G4", .7],
        ["F4", 1]

    ];


    let time = 0;


    melody.forEach(
        ([note, duration]) => {

            playNote(
                note,
                duration,
                time
            );

            time +=
                duration * 1000;

        }
    );


    document.getElementById(
        "musicInfo"
    ).innerHTML =
        "🎵 Birthday melody dimainkan ❤️";

}


/* =========================
   BUKA AMPLOP
========================= */

function openCard() {

    const envelope =
        document.getElementById(
            "envelope"
        );


    const card =
        document.getElementById(
            "card"
        );


    envelope.classList.add(
        "open"
    );


    playMusic();


    setTimeout(() => {

        card.classList.add(
            "show"
        );

    }, 600);


    /* Tombol hadiah muncul */

    setTimeout(() => {

        document
            .getElementById(
                "giftButton"
            )
            .classList.add(
                "show"
            );

    }, 1800);


    setTimeout(() => {

        createConfetti(40);

        createFlowers(12);

    }, 1000);

}


/* =========================
   TOMBOL HADIAH
========================= */

function openGift() {

    const message =
        document.getElementById(
            "giftMessage"
        );


    const button =
        document.getElementById(
            "giftButton"
        );


    message.classList.add(
        "show"
    );


    button.innerHTML =
        "💝 Hadiahnya Rahasia";


    createConfetti(60);

    createFlowers(18);

}


/* =========================
   CONFETTI
========================= */

function createConfetti(
    amount
) {

    for (
        let i = 0;
        i < amount;
        i++
    ) {

        const confetti =
            document.createElement(
                "div"
            );


        confetti.className =
            "confetti";


        confetti.style.left =
            Math.random() * 100 +
            "vw";


        confetti.style.animationDuration =
            (2 + Math.random() * 3) +
            "s";


        confetti.style.background =
            `hsl(
                ${Math.random() * 360},
                80%,
                65%
            )`;


        document.body.appendChild(
            confetti
        );


        setTimeout(() => {

            confetti.remove();

        }, 6000);

    }

}


/* =========================
   BUNGA
========================= */

function createFlowers(
    amount
) {

    const flowers = [
        "🌸",
        "🌷",
        "🌹",
        "🌺",
        "🌻",
        "💐"
    ];


    for (
        let i = 0;
        i < amount;
        i++
    ) {

        const flower =
            document.createElement(
                "div"
            );


        flower.className =
            "flower";


        flower.innerHTML =
            flowers[
                Math.floor(
                    Math.random() *
                    flowers.length
                )
            ];


        flower.style.left =
            Math.random() * 100 +
            "vw";


        flower.style.top =
            (50 +
            Math.random() * 40) +
            "vh";


        flower.style.animationDelay =
            Math.random() * 1.5 +
            "s";


        document.body.appendChild(
            flower
        );


        setTimeout(() => {

            flower.remove();

        }, 4000);

    }

}

</script>

</body>
</html>
